generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  AGENT
  LOADER
  HOST
  GUEST
}

enum ListingCategory {
  STAY
  CAR
  SERVICE
  FOOD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  password String
  role     Role
  isActive Boolean @default(true)

  passwordResetCode    String?
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestProfile      GuestProfile?
  agentProfile      AgentProfile?
  hostProfile       HostProfile?
  loadedDirectories DirectoryListing[] @relation("UserLoadedDirectories")

  @@map("users")
}

model GuestProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  countriesToVisit   String[]
  interests          String?
  allergies          String?
  extraText          String?
  subscriptionStatus Boolean  @default(false)

  country                  String?
  city                     String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  currency                 String? @default("USD")
  language                 String? @default("en")
  emailNotifications       Boolean @default(true)
  smsNotifications         Boolean @default(true)
  marketingEmails          Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@map("guest_profiles")
}

enum AdminPermission {
  LOAD_DIRECTORY
  APPROVE_CLAIMS
  MANAGE_GUESTS
  MANAGE_TEAM
  VIEW_REVENUE
}

model AgentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permissions       AdminPermission[] @default([])
  assignedCountries String[]          @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_profiles")
}

enum HostType {
  RENTAL_PROPERTY_REGISTERED
  INDIVIDUAL_PROPERTY
  CAR_RENTAL
  RESTAURANT
  BARBERSHOP
  SPA_SALON
}

enum HostApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model HostProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hostTypes          HostType[]
  businessName       String?
  location           String?
  address            String?
  country            String?
  city               String?
  state              String?
  registrationNumber String?
  description        String?

  approvalStatus HostApprovalStatus @default(PENDING)

  payoutAccount      String?
  billingCurrency    String? @default("USD")
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(true)
  marketingEmails    Boolean @default(false)

  documents HostDocument[]
  listings  Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("host_profiles")
}

enum DocumentType {
  GOV_ID
  KKF_CERTIFICATE
  OWNERSHIP_PROOF
  PROPERTY_INSURANCE
  TAX_DOCUMENT
  HANDEL_PERMIT
  LOGO
  OTHER
}

model HostDocument {
  id          String      @id @default(uuid())
  hostId      String
  hostProfile HostProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)

  documentType DocumentType
  fileUrl      String

  uploadedAt DateTime @default(now())

  @@map("host_documents")
}

enum ListingApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Listing {
  id             String                @id @default(uuid())
  hostId         String
  host           HostProfile           @relation(fields: [hostId], references: [id], onDelete: Cascade)
  category       ListingCategory
  title          String
  description    String?
  location       String?
  city           String?
  country        String?
  rating         Float                 @default(0.0)
  reviewCount    Int                   @default(0)
  isActive       Boolean               @default(true)
  approvalStatus ListingApprovalStatus @default(PENDING)

  images ListingImage[]

  stayDetails    StayDetails?
  carDetails     CarDetails?
  serviceDetails ServiceDetails?
  foodDetails    FoodDetails?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  isHero    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("listing_images")
}

model StayDetails {
  id            String   @id @default(uuid())
  listingId     String   @unique
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pricePerNight Float
  amenities     String[]

  @@map("stay_details")
}

model CarDetails {
  id            String   @id @default(uuid())
  listingId     String   @unique
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dailyRate     Float
  carType       String
  seats         Int
  transmission  String
  doors         Int?
  bags          Json?
  features      String[]
  includedItems String[]

  fuelOptions     Json?
  protectionPlans Json?
  extras          Json?

  pickupLocations String[]
  returnLocations String[]

  @@map("car_details")
}

model ServiceDetails {
  id                 String   @id @default(uuid())
  listingId          String   @unique
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  serviceType        String
  availableTimeSlots String[]

  packages ServicePackage[]

  @@map("service_details")
}

model ServicePackage {
  id               String         @id @default(uuid())
  serviceDetailsId String
  serviceDetails   ServiceDetails @relation(fields: [serviceDetailsId], references: [id], onDelete: Cascade)
  name             String
  price            Float
  imageUrl         String?

  @@map("service_packages")
}

model Booking {
  id        String       @id @default(uuid())
  guestId   String
  guest     GuestProfile @relation(fields: [guestId], references: [id])
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id])

  status BookingStatus @default(PENDING)

  totalAmount   Float
  depositAmount Float?

  bookingData Json

  otpCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

model FoodDetails {
  id        String     @id @default(uuid())
  listingId String     @unique
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  items     FoodItem[]

  @@map("food_details")
}

model FoodItem {
  id            String      @id @default(uuid())
  foodDetailsId String
  foodDetails   FoodDetails @relation(fields: [foodDetailsId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  price         Float
  imageUrl      String?

  @@map("food_items")
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  target    Int      @default(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

enum DirectoryStatus {
  UNCLAIMED
  CLAIMED
}

model DirectoryListing {
  id             String @id @default(uuid())
  country        String
  businessName   String
  businessNumber String
  address        String
  primaryImage   String
  status         DirectoryStatus @default(UNCLAIMED)

  loadedById String
  loadedBy   User   @relation("UserLoadedDirectories", fields: [loadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("directory_listings")
}
